rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'SUPER_ADMIN';
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'SCHOOL_ADMIN' && getUserData().schoolId == schoolId);
    }

    function isTeacher(schoolId) {
      return isSignedIn() && (getUserData().role == 'TEACHER' && getUserData().schoolId == schoolId);
    }

    function isStudent(schoolId) {
      return isSignedIn() && (getUserData().role == 'STUDENT' && getUserData().schoolId == schoolId);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schools
    match /schools/{schoolId} {
      allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacher(schoolId) || isStudent(schoolId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isSchoolAdmin(schoolId);
      allow delete: if isSuperAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (request.auth.uid == userId || getUserData().schoolId == resource.data.schoolId));
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Students
    match /students/{studentId} {
      allow read: if isSuperAdmin() || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    // Teachers
    match /teachers/{teacherId} {
      allow read: if isSuperAdmin() || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    // Classes
    match /classes/{classId} {
      allow read: if isSuperAdmin() || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if isSuperAdmin() || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    // Results
    match /results/{resultId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (getUserData().schoolId == resource.data.schoolId || getUserData().schoolId == request.resource.data.schoolId));
      allow create: if isTeacher(request.resource.data.schoolId);
      allow update: if isSchoolAdmin(resource.data.schoolId) || (isTeacher(resource.data.schoolId) && resource.data.status != 'APPROVED');
      allow delete: if isSchoolAdmin(resource.data.schoolId);
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin() || (isSignedIn() && (getUserData().schoolId == resource.data.schoolId || getUserData().schoolId == request.resource.data.schoolId));
      allow create, update: if isTeacher(request.resource.data.schoolId);
      allow delete: if isSchoolAdmin(resource.data.schoolId);
    }

    // Sessions
    match /sessions/{sessionId} {
      allow read: if isSuperAdmin() || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if false;
    }

    // ── CHATS ──────────────────────────────────────────────────────────────

    // 1. Super Admin <-> School Admin support chats (chatId === schoolId)
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolAdmin(chatId) ||
        (resource.data.type == 'dm' && resource.data.schoolId != null && (
          isSchoolAdmin(resource.data.schoolId) ||
          (isTeacher(resource.data.schoolId) && (
            request.auth.uid == resource.data.teacherId ||
            request.auth.uid == resource.data.adminId
          ))
        )) ||
        (resource.data.type == 'group' && resource.data.schoolId != null && (
          isSchoolAdmin(resource.data.schoolId) ||
          (isTeacher(resource.data.schoolId) && request.auth.uid in resource.data.memberIds)
        ))
      );

      allow write: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolAdmin(chatId) ||
        (resource.data.type == 'dm' && resource.data.schoolId != null && (
          isSchoolAdmin(resource.data.schoolId) ||
          (isTeacher(resource.data.schoolId) && (
            request.auth.uid == resource.data.teacherId ||
            request.auth.uid == resource.data.adminId
          ))
        )) ||
        (resource.data.type == 'group' && resource.data.schoolId != null && (
          isSchoolAdmin(resource.data.schoolId) ||
          (isTeacher(resource.data.schoolId) && request.auth.uid in resource.data.memberIds)
        ))
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isSuperAdmin() ||
          isSchoolAdmin(chatId) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'dm' &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId != null && (
              isSchoolAdmin(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) ||
              (isTeacher(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) && (
                request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.teacherId ||
                request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.adminId
              ))
            )
          ) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId != null && (
              isSchoolAdmin(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) ||
              (isTeacher(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) &&
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds)
            )
          )
        );

        allow create, update: if isSignedIn() && (
          isSuperAdmin() ||
          isSchoolAdmin(chatId) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'dm' &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId != null && (
              isSchoolAdmin(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) ||
              (isTeacher(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) && (
                request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.teacherId ||
                request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.adminId
              ))
            )
          ) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'group' &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId != null && (
              isSchoolAdmin(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) ||
              (isTeacher(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId) &&
                request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds &&
                get(/databases/$(database)/documents/chats/$(chatId)).data.isOpen == true)
            )
          )
        );

        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == 'SUPER_ADMIN';
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == 'SCHOOL_ADMIN'
        && getUserData().schoolId == schoolId;
    }

    function isTeacher(schoolId) {
      return isSignedIn()
        && getUserData().role == 'TEACHER'
        && getUserData().schoolId == schoolId;
    }

    function isStudent(schoolId) {
      return isSignedIn()
        && getUserData().role == 'STUDENT'
        && getUserData().schoolId == schoolId;
    }

    function isSupportChatForSchoolAdmin(chatId) {
      return isSignedIn()
        && getUserData().role == 'SCHOOL_ADMIN'
        && getUserData().schoolId == chatId;
    }

    function isGroupChatMember(chatId) {
      return isSignedIn()
        && (getUserData().role == 'SCHOOL_ADMIN' || getUserData().role == 'TEACHER')
        && chatId == 'group_' + getUserData().schoolId;
    }

    function isTeacherDmChat(chatId) {
      return isSignedIn()
        && getUserData().role == 'TEACHER'
        && chatId == 'dm_' + getUserData().schoolId + '_' + request.auth.uid;
    }

    match /schools/{schoolId} {
      allow read: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacher(schoolId) || isStudent(schoolId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isSchoolAdmin(schoolId);
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && (request.auth.uid == userId || getUserData().schoolId == resource.data.schoolId));
      allow write: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == userId);
    }

    match /students/{studentId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    match /teachers/{teacherId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    match /classes/{classId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    match /subjects/{subjectId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    match /results/{resultId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && (
          getUserData().schoolId == resource.data.schoolId
          || getUserData().schoolId == request.resource.data.schoolId
        ));
      allow create: if isTeacher(request.resource.data.schoolId);
      allow update: if isSchoolAdmin(resource.data.schoolId)
        || (isTeacher(resource.data.schoolId) && resource.data.status != 'APPROVED');
      allow delete: if isSchoolAdmin(resource.data.schoolId);
    }

    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && (
          getUserData().schoolId == resource.data.schoolId
          || getUserData().schoolId == request.resource.data.schoolId
        ));
      allow create, update: if isTeacher(request.resource.data.schoolId);
      allow delete: if isSchoolAdmin(resource.data.schoolId);
    }

    match /sessions/{sessionId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && getUserData().schoolId == resource.data.schoolId);
      allow write: if isSuperAdmin() || isSchoolAdmin(resource.data.schoolId);
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        isSuperAdmin()
        || isSupportChatForSchoolAdmin(chatId)
        || isGroupChatMember(chatId)
        || isTeacherDmChat(chatId)
        || (getUserData().role == 'SCHOOL_ADMIN'
            && resource.data.schoolId == getUserData().schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin()
        || isSupportChatForSchoolAdmin(chatId)
        || isGroupChatMember(chatId)
        || isTeacherDmChat(chatId)
        || (getUserData().role == 'SCHOOL_ADMIN'
            && request.resource.data.schoolId == getUserData().schoolId)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          isSuperAdmin()
          || isSupportChatForSchoolAdmin(chatId)
          || isGroupChatMember(chatId)
          || isTeacherDmChat(chatId)
          || (getUserData().role == 'SCHOOL_ADMIN'
              && get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId == getUserData().schoolId)
        );
        allow create, update: if isSignedIn() && (
          isSuperAdmin()
          || isSupportChatForSchoolAdmin(chatId)
          || isGroupChatMember(chatId)
          || isTeacherDmChat(chatId)
          || (getUserData().role == 'SCHOOL_ADMIN'
              && get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId == getUserData().schoolId)
        );
        allow delete: if isSignedIn()
          && request.auth.uid == resource.data.senderId;
      }
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      allow create: if false;
    }
  }
}

{
  "entities": {
    "School": {
      "title": "School",
      "description": "Represents a school entity in the system.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "logoUrl": { "type": "string" },
        "plan": { "type": "string", "enum": ["BASIC", "PRO", "PREMIUM"] },
        "userLimit": { "type": "number" },
        "superAdminId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "superAdminId"]
    },
    "User": {
      "title": "User",
      "description": "Staff or student account.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "SCHOOL_ADMIN", "TEACHER", "STUDENT"] },
        "schoolId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role", "passwordHash"]
    },
    "Student": {
      "title": "Student",
      "description": "Student specific data.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "schoolId": { "type": "string" },
        "classId": { "type": "string" },
        "stream": { "type": "string", "enum": ["GENERAL", "SCIENCE", "COMMERCIAL", "ARTS"] },
        "admissionNumber": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "schoolId"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher specific data.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "schoolId": { "type": "string" },
        "employeeId": { "type": "string" },
        "specialization": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "assignedClassIds": { "type": "array", "items": { "type": "string" } },
        "assignedSubjectIds": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "schoolId"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily student attendance record.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "schoolId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "LATE", "EXCUSED"] },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "classId", "schoolId", "date", "status", "recordedBy"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log for system actions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "schoolId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "schoolId"]
    },
    "Class": {
      "title": "Class",
      "description": "A school class (e.g. SS1, JSS2).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "level": { "type": "string", "enum": ["CRECHE", "KINDERGARTEN", "NURSERY", "PRIMARY", "JSS", "SSS"] },
        "schoolId": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "level", "schoolId"]
    },
    "Subject": {
      "title": "Subject",
      "description": "A curriculum subject.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "schoolId": { "type": "string" },
        "level": { "type": "string", "enum": ["CRECHE", "KINDERGARTEN", "NURSERY", "PRIMARY", "JSS", "SSS"] },
        "class": { "type": "string" },
        "stream": { "type": "string", "enum": ["GENERAL", "SCIENCE", "COMMERCIAL", "ARTS"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "schoolId", "level", "class"]
    },
    "Result": {
      "title": "Result",
      "description": "Student academic performance for a subject in a term.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "schoolId": { "type": "string" },
        "ca1": { "type": "number" },
        "ca2": { "type": "number" },
        "exam": { "type": "number" },
        "total": { "type": "number" },
        "grade": { "type": "string" },
        "term": { "type": "string", "enum": ["1st", "2nd", "3rd"] },
        "session": { "type": "string" },
        "teacherId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "classId", "subjectId", "schoolId", "term", "session"]
    },
    "Session": {
       "title": "Session",
       "description": "Academic year (e.g. 2023/2024).",
       "type": "object",
       "properties": {
         "name": { "type": "string" },
         "schoolId": { "type": "string" },
         "isCurrent": { "type": "boolean" },
         "createdAt": { "type": "string", "format": "date-time" }
       },
       "required": ["name", "schoolId"]
    }
  },
  "firestore": {
    "schools": { "schema": "School", "description": "Collection of schools." },
    "users": { "schema": "User", "description": "Collection of users." },
    "students": { "schema": "Student", "description": "Collection of students." },
    "teachers": { "schema": "Teacher", "description": "Collection of teachers." },
    "classes": { "schema": "Class", "description": "Collection of classes." },
    "subjects": { "schema": "Subject", "description": "Collection of subjects." },
    "results": { "schema": "Result", "description": "Collection of student results." },
    "sessions": { "schema": "Session", "description": "Academic years." }
  }
}
